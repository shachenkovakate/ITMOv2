{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/itmo-agent",
  "small_model": "ollama/itmo-agent",
  "enabled_providers": ["ollama"],
  "default_agent": "local-guide",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama local",
      "options": {"baseURL": "http://127.0.0.1:11434/v1"},
      "models": {
        "itmo-agent": {
          "name": "ITMO local 64k",
          "limit": {"context": 65536, "output": 4096},
          "temperature": true,
          "options": {"reasoningEffort": "none"}
        }
      }
    }
  },
  "agent": {
    "local-guide": {
      "description": "Read-only local repository assistant",
      "mode": "primary",
      "prompt": "{file:./prompt-a.txt}",
      "temperature": 0.2,
      "steps": 8,
      "permission": {"*": "deny", "read": "allow", "glob": "allow", "grep": "allow", "external_directory": "deny"}
    }
  },
  "plugin": [],
  "mcp": {},
  "share": "disabled",
  "autoupdate": false,
  "snapshot": false,
  "lsp": false,
  "formatter": false
}
