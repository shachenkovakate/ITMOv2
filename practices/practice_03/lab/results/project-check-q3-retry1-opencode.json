{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/itmo-agent",
  "small_model": "ollama/itmo-agent",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama local",
      "options": {
        "baseURL": "http://127.0.0.1:40451/v1"
      },
      "models": {
        "itmo-agent": {
          "name": "ITMO local 64k",
          "limit": {
            "context": 65536,
            "output": 4096
          },
          "options": {
            "reasoningEffort": "none"
          },
          "temperature": true
        }
      }
    }
  },
  "agent": {
    "local-guide": {
      "description": "Read-only local repository assistant",
      "mode": "primary",
      "prompt": "{file:/tmp/opencode/project-check-q3-retry1-m9yw_v5p/demo/repo-system.txt}",
      "steps": 8,
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow"
      },
      "temperature": 0.2
    }
  },
  "enabled_providers": [
    "ollama"
  ],
  "default_agent": "local-guide",
  "plugin": [],
  "mcp": {},
  "share": "disabled",
  "autoupdate": false,
  "snapshot": false,
  "lsp": false,
  "formatter": false
}
